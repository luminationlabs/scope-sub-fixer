{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scope Sub Fixer",
  "version": "0.9.0",
  "identifier": "com.luminationlabs.scopesubfixer",
  "build": {
    "beforeDevCommand": "pnpm dev:web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scope Sub Fixer",
        "width": 1060,
        "height": 740,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "publisher": "Lumination Labs",
    "category": "Video",
    "shortDescription": "Move Blu-ray subtitles out of the letterbox bars",
    "externalBin": ["binaries/scope-sub-engine"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [],
        "contentTypes": ["public.folder"],
        "name": "Folder",
        "role": "Viewer",
        "rank": "None"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist"
    }
  }
}
